# ==============================================================================
# OpenShogun — Configuration de l'Environnement (12-Factor App)
# Copiez ce fichier vers .env et adaptez les valeurs à votre infrastructure
# ==============================================================================

# Environnement applicatif (production / development / test)
APP_ENV=production
APP_DEBUG=false

# URL publique de l'application
SITE_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# Base de Données MySQL / MariaDB
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=openshogun
DB_USER=root
DB_PASS=VotreMotDePasseSecurise123!
DB_CHARSET=utf8mb4

# Mot de passe root pour Docker Compose (optionnel si MariaDB dédié)
MYSQL_ROOT_PASSWORD=RootMotDePasseSecurise123!

# ------------------------------------------------------------------------------
# Paramètres du Monde Féodal & Gameplay
# ------------------------------------------------------------------------------
# Vitesse globale (1 = standard, 5 = rapide, 10 = blitz)
SPEED_FACTOR=5
GAME_TITLE="OpenShogun — Chroniques Féodales"

# ------------------------------------------------------------------------------
# Administrateur Initial (Shogun)
# ------------------------------------------------------------------------------
ADMIN_USER=shogun
ADMIN_EMAIL=admin@openshogun.local
ADMIN_PASS=ShogunPass2026!
ADMIN_FACTION=terran
